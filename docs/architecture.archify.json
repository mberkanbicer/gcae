  "cards": [
    {
      "dot": "cyan",
      "title": "Execution loop",
      "items": [
        "RECONSTRUCT → ACT → OBSERVE → JUDGE → COMMIT/REVERT → LEARN",
        "The unit of progress is a semantic trajectory step, not a tool call",
        "Action ≠ progress: stagnation is measured by accepted checkpoints"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence",
      "items": [
        "The evidence ledger lives in SQLite: command results, validations, criterion verdicts",
        "Completion = every success criterion PASS + mapped ledger evidence",
        "memory.db survives every rollback; knowledge accumulates"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust & recovery",
      "items": [
        "Commands run through the [sandbox] command_prefix wrapper",
        "The model can never run Git checkpoint commands",
        "Only a verified merge writes to the user's working tree"
      ]
    }
  ]
