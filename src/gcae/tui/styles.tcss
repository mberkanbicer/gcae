/* GCAE dashboard theme.
 *
 * Semantic selectors only: run state, checkpoint/candidate, validation, evaluation and
 * focus.  Colours come from the Textual theme so terminal themes stay usable; text
 * colour inside panels is set by gcae.tui.formatters.STYLES.
 *
 * Layout principle: the main region absorbs slack so a long plan or a long check list
 * becomes *more visible content*, while the event timeline keeps a bounded height.  The
 * old design gave the timeline `1fr`, which turned most of the screen into an empty log
 * panel on a tall terminal.
 */

Screen {
    background: $background;
}

/* Panels take the container width: content must never set the width, otherwise a render
 * before the first layout locks the panel into a tiny width. */
#status,
#objective,
#plan,
#activity,
#checkpoint,
#evaluation,
#validation,
#banner,
#metrics,
#timeline,
#footer,
.rule {
    width: 1fr;
}

/* ------------------------------------------------------------------ top bar */

#status {
    height: 1;
    padding: 0 1;
    background: $surface;
    text-style: bold;
}

/* ------------------------------------------------------------------ layout */

#main {
    height: 1fr;
    layout: horizontal;
}

#column-left {
    width: 2fr;
    height: 1fr;
}

#column-right {
    width: 3fr;
    height: 1fr;
}

/* Left column: the objective is capped, the plan grows (more steps visible). */
/* Every panel is either fixed (its content changes several times per step) or `1fr` (it
 * absorbs the slack).  No panel is content sized, so nothing on the screen moves while the
 * agent works: content windows inside the boxes instead of resizing them. */
#objective {
    height: 5;
    padding: 0 1;
}

#plan {
    height: 1fr;
    padding: 0 1;
}

/* Right column: ACTIVE, CHECKPOINT and VALIDATION are fixed (7 + 6 + 5 rows) because their
 * content changes several times per step; the EVALUATION box absorbs the slack, so spare rows
 * land at the bottom edge of the column instead of moving the panels above it. */
/* Fixed, not content sized: the ACTIVE box changes shape several times per tool call
 * (waiting for the model → generating → running → done).  A fixed box means nothing below
 * it moves while the agent works; the panel keeps its most important rows and drops the
 * least important one when the content does not fit. */
#activity {
    height: 7;
    padding: 0 1;
}

/* Fixed boxes for the two panels whose content arrives during a step (the candidate file
 * list, then the check results).  They are sized for the shape they normally have, so the
 * column never reflows while the agent works; the evaluation box below absorbs the slack. */
#checkpoint {
    height: 6;
    padding: 0 1;
}

#evaluation {
    height: 1fr;
    padding: 0 1;
}

#validation {
    height: 5;
    padding: 0 1;
}

/* Stacked (narrow) screens scroll inside the main region so the status bar, timeline
 * and footer stay pinned and reachable. */
#main.stacked {
    layout: vertical;
    height: 1fr;
    overflow-y: auto;
    padding-right: 2;
}

#main.stacked #column-left,
#main.stacked #column-right {
    width: 1fr;
    height: auto;
}

#main.stacked #objective,
#main.stacked #evaluation,
#main.stacked #plan {
    height: auto;
    max-height: 12;
}

#banner {
    height: auto;
    max-height: 7;
    padding: 0 1;
    background: $surface;
}

/* ------------------------------------------------------------- status strip */

#metrics {
    height: 1;
    padding: 0 1;
    background: $surface;
}

.rule {
    height: 1;
    padding: 0 1;
}

/* ---------------------------------------------------------------- timeline */

/* Fixed per breakpoint: the semantic story is a strip, not the screen.  A fixed box means
 * a long run does not *grow* the timeline and push the panels above it; the panel shows the
 * newest rows and counts the rest ("N earlier · l for the full log"). */
#timeline {
    height: 7;
    padding: 0 1;
}

#timeline.tall {
    height: 11;
}

#timeline.mid {
    height: 9;
}

#timeline.short {
    height: 5;
}

#timeline.compact {
    height: 4;
}

#footer {
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $text-muted;
}

/* ---------------------------------------------------------------- focus */
/* Subtle and reflow-free: only the background changes when a panel is focused. */

#objective:focus,
#activity:focus,
#checkpoint:focus,
#evaluation:focus,
#validation:focus,
#plan:focus,
#timeline:focus {
    background: $panel;
}

/* ------------------------------------------------------------- dialogs */

DialogScreen,
ViewerScreen {
    align: center middle;
}

#dialog {
    width: 80%;
    max-width: 90;
    min-width: 24;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#dialog-hint,
#dialog-body-text {
    padding: 0 0 1 0;
    color: $text-muted;
}

#dialog-input {
    border: tall $accent;
}

#viewer {
    width: 96%;
    height: 92%;
    background: $surface;
    border: round $accent;
}

#viewer-title {
    height: 1;
    padding: 0 1;
    background: $panel;
    text-style: bold;
}

#viewer-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#diff-body,
#context-body {
    height: 1fr;
}

#viewer-scroll,
#viewer-scroll-list {
    height: 1fr;
    padding: 0 1;
}

#viewer-scroll-list {
    width: 36;
    background: $panel;
}

#diff-files,
#context-sections {
    height: auto;
}

#viewer-scroll-list ListItem {
    padding: 0 1;
}
