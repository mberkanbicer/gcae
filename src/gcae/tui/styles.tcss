/* GCAE dashboard theme.
 *
 * Semantic selectors only: run state, checkpoint/candidate, validation, evaluation and
 * focus.  Colours come from the Textual theme so terminal themes stay usable; text
 * colour inside panels is set by gcae.tui.formatters.STYLES.
 *
 * Layout principle: the main region absorbs slack so a long plan or a long check list
 * becomes *more visible content*, while the event timeline keeps a bounded height.  The
 * old design gave the timeline `1fr`, which turned most of the screen into an empty log
 * panel on a tall terminal.
 */

Screen {
    background: $background;
}

/* Panels take the container width: content must never set the width, otherwise a render
 * before the first layout locks the panel into a tiny width. */
#status,
#objective,
#plan,
#activity,
#checkpoint,
#evaluation,
#validation,
#banner,
#metrics,
#timeline,
#footer,
.rule {
    width: 1fr;
}

/* ------------------------------------------------------------------ top bar */

#status {
    height: 1;
    padding: 0 1;
    background: $surface;
    text-style: bold;
}

/* ------------------------------------------------------------------ layout */

#main {
    height: 1fr;
    layout: horizontal;
}

#column-left {
    width: 2fr;
    height: 1fr;
}

#column-right {
    width: 3fr;
    height: 1fr;
}

/* Left column: the objective is capped, the plan grows (more steps visible). */
#objective {
    height: auto;
    max-height: 8;
    padding: 0 1;
}

#plan {
    height: 1fr;
    padding: 0 1;
}

/* Right column: ACTIVE, CHECKPOINT and VALIDATION size to their content (validation up to a
 * cap) and the EVALUATION box absorbs the slack, so spare rows land at the bottom edge of the
 * column rather than as a hole between two panels. */
#activity {
    height: auto;
    max-height: 13;
    padding: 0 1;
}

#checkpoint {
    height: auto;
    max-height: 12;
    padding: 0 1;
}

#evaluation {
    height: 1fr;
    padding: 0 1;
}

#validation {
    height: auto;
    max-height: 12;
    padding: 0 1;
}

/* Stacked (narrow) screens scroll inside the main region so the status bar, timeline
 * and footer stay pinned and reachable. */
#main.stacked {
    layout: vertical;
    height: 1fr;
    overflow-y: auto;
    padding-right: 2;
}

#main.stacked #column-left,
#main.stacked #column-right {
    width: 1fr;
    height: auto;
}

#main.stacked #objective,
#main.stacked #activity,
#main.stacked #checkpoint,
#main.stacked #evaluation,
#main.stacked #validation,
#main.stacked #plan {
    height: auto;
    max-height: 12;
}

#banner {
    height: auto;
    max-height: 7;
    padding: 0 1;
    background: $surface;
}

/* ------------------------------------------------------------- status strip */

#metrics {
    height: 1;
    padding: 0 1;
    background: $surface;
}

.rule {
    height: 1;
    padding: 0 1;
}

/* ---------------------------------------------------------------- timeline */

/* Bounded: the semantic story is a strip, not the screen.  Extra rows become more
 * visible history up to the cap, then the panel scrolls its window. */
#timeline {
    height: auto;
    min-height: 5;
    max-height: 13;
    padding: 0 1;
}

#timeline.compact {
    max-height: 6;
}

#footer {
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $text-muted;
}

/* ---------------------------------------------------------------- focus */
/* Subtle and reflow-free: only the background changes when a panel is focused. */

#objective:focus,
#activity:focus,
#checkpoint:focus,
#evaluation:focus,
#validation:focus,
#plan:focus,
#timeline:focus {
    background: $panel;
}

/* ------------------------------------------------------------- dialogs */

DialogScreen,
ViewerScreen {
    align: center middle;
}

#dialog {
    width: 80%;
    max-width: 90;
    min-width: 24;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#dialog-hint,
#dialog-body-text {
    padding: 0 0 1 0;
    color: $text-muted;
}

#dialog-input {
    border: tall $accent;
}

#viewer {
    width: 96%;
    height: 92%;
    background: $surface;
    border: round $accent;
}

#viewer-title {
    height: 1;
    padding: 0 1;
    background: $panel;
    text-style: bold;
}

#viewer-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#diff-body,
#context-body {
    height: 1fr;
}

#viewer-scroll,
#viewer-scroll-list {
    height: 1fr;
    padding: 0 1;
}

#viewer-scroll-list {
    width: 36;
    background: $panel;
}

#diff-files,
#context-sections {
    height: auto;
}

#viewer-scroll-list ListItem {
    padding: 0 1;
}
